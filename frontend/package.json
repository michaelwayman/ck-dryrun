{
  "name": "brand-reviews-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "//": [
    "typescript ~6.0: typescript-eslint 8.72 peers typescript >=4.8.4 <6.1.0, so 7.x is excluded.",
    "eslint and @eslint/js ^9: eslint-plugin-jsx-a11y 6.10.2 peers eslint up to ^9, so 10.x is excluded."
  ],
  "scripts": {
    "build": "vite build",
    "build:css": "if [ -f scss/main.scss ]; then sass --no-source-map scss/main.scss dist/css/main.css; else echo \"build:css: no scss/main.scss yet, skipped\"; fi",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:css": "stylelint \"scss/**/*.scss\" --allow-empty-input && node scripts/css-diff.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
